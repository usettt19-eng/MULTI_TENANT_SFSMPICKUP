# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="localhost:3000"

# SUPABASE: Required for database connection.
# Get these from your Supabase project settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# NUNCA con prefijo VITE_: Vite la empotraría en el bundle del navegador.
# Es la llave maestra que salta toda política RLS. Va en
# SUPABASE_SERVICE_ROLE_KEY (más abajo), y solo la lee server/, nunca el frontend.

# WELLNESS API: Backend server for medications and critical alerts
VITE_WELLNESS_API_URL="http://localhost:3001"

# HOST_PORT: puerto del host donde se publica el contenedor (ver DESPLIEGUE.md).
HOST_PORT=8095

# ── API interna (server/) ──────────────────────────────────────────────────
# NUNCA con prefijo VITE_: se empotraría en el bundle del navegador. Es la
# llave maestra que salta toda política RLS.
SUPABASE_SERVICE_ROLE_KEY=
