# URL del proyecto de Supabase (la misma que usa el frontend).
SUPABASE_URL=https://fvzhfzogigewsvcyopel.supabase.co

# CLAVE SERVICE_ROLE: salta TODAS las políticas RLS.
# No debe salir nunca de este proceso ni acabar en el frontend.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Puerto interno del servicio.
PORT=3001

# URL pública del frontend, a donde vuelve el usuario tras aceptar un correo
# de invitación (admin.auth.admin.inviteUserByEmail). Opcional: si se omite,
# Supabase usa la "Site URL" configurada en Authentication -> URL Configuration.
PUBLIC_APP_URL=https://safesmartpickup.com
